{
  "manifest_version": 3,
  "name": "Do You Really Wanna?",
  "short_name": "Really?",
  "version": "0.3.0",
  "description": "A gentle pause before the sites you open on autopilot. Nothing is blocked, and nothing ever leaves your computer.",
  "minimum_chrome_version": "123",
  "browser_specific_settings": {
    "gecko": {
      "id": "do-you-really-wanna@matejmaricia.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "alarms", "activeTab"],
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Do You Really Wanna?",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pause/pause.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
